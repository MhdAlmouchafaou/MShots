{
  "expo": {
    "name": "MShots",
    "slug": "mshots",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mshots",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F1EC",
    "android": {
      "package": "com.mhdalmouchafaou.mshots",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E9E7E2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.INTERNET"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F3F1EC",
          "dark": { "backgroundColor": "#0B0B0C", "image": "./assets/splash-icon-dark.png" }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MShots enregistre vos mockups dans la galerie et y lit vos captures.",
          "savePhotosPermission": "MShots enregistre vos mockups dans la galerie.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "MShots importe vos captures d’écran depuis la galerie.", "cameraPermission": false, "microphonePermission": false }
      ],
      [
        "expo-build-properties",
        { "android": { "minSdkVersion": 26, "enableMinifyInReleaseBuilds": false, "useLegacyPackaging": true } }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": { "typedRoutes": false }
  }
}
